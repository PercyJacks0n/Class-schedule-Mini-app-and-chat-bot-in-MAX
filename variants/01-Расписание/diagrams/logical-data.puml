@startuml
entity "Справочник 1С\n<<внешний>>" as External1C {
  * идентификатор объекта
  --
  структура, сотрудники, группы, планы
}
entity "Расписание и Сводка" as Schedule {
  * id_занятия
  --
  дата, время, дисциплина
  аудитория, тип_пары
}
entity "Запись журнала аудита" as AuditLog {
  * id_записи
  --
  метка_времени
  инициатор
  тип_операции
  статус
}
entity "Конфликт / Коллизия" as Conflict {
  * id_конфликта
  --
  описание_ошибки
  признак_конфликта
}
entity "Пользовательская подписка" as Subscription {
  * id_подписки
  --
  id_пользователя_max
  целевая_группа_или_преподаватель
}

External1C ||--o{ Schedule : импортирует
Schedule ||--o| Conflict : порождает_при_накладке
Schedule ||--o{ Subscription : используется_для_уведомлений
AuditLog }o--|| Schedule : фиксирует_операции_с
@enduml